; Diagnostic project only. Independent from the user's root game project.
config_version=5

[application]
config/name="Godot Development Playground"
run/main_scene="res://calibration.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.07, 1)
